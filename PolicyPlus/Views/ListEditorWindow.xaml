<ui:FluentWindow
    x:Class="PolicyPlus.Views.ListEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Edit List"
    Width="460"
    Height="320"
    MinWidth="380"
    MinHeight="260"
    ExtendsContentIntoTitleBar="True"
    KeyDown="Window_KeyDown"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Edit List" />

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="ElementNameLabel"
                Grid.Row="0"
                Margin="0,0,0,8"
                Text="List element name"
                TextWrapping="Wrap" />

            <ui:DataGrid
                x:Name="EntriesGrid"
                Grid.Row="1"
                Margin="0,0,0,12"
                AutoGenerateColumns="False"
                CanUserSortColumns="False"
                HeadersVisibility="Column">
                <ui:DataGrid.Columns>
                    <DataGridTextColumn
                        x:Name="NameColumn"
                        Width="*"
                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                        Header="Name" />
                    <DataGridTextColumn
                        x:Name="ValueColumn"
                        Width="*"
                        Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                        Header="Value" />
                </ui:DataGrid.Columns>
            </ui:DataGrid>

            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    Click="CancelButton_Click"
                    Content="Cancel"
                    IsCancel="True" />
                <ui:Button
                    Appearance="Primary"
                    Click="OkButton_Click"
                    Content="OK"
                    IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
