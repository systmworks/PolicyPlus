<ui:FluentWindow
    x:Class="PolicyPlus.Views.DetailCategoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Category Details"
    Width="420"
    SizeToContent="Height"
    ExtendsContentIntoTitleBar="True"
    KeyDown="Window_KeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Category Details" />

        <StackPanel
            Grid.Row="1"
            Margin="16"
            VerticalAlignment="Top">
            <TextBlock Margin="0,0,0,4" Text="Name" />
            <ui:TextBox
                x:Name="NameTextbox"
                Margin="0,0,0,12"
                IsReadOnly="True" />
            <TextBlock Margin="0,0,0,4" Text="Unique ID" />
            <ui:TextBox
                x:Name="IdTextbox"
                Margin="0,0,0,12"
                IsReadOnly="True" />
            <TextBlock Margin="0,0,0,4" Text="Defined in" />
            <ui:TextBox
                x:Name="DefinedTextbox"
                Margin="0,0,0,12"
                IsReadOnly="True" />
            <TextBlock Margin="0,0,0,4" Text="Display code" />
            <ui:TextBox
                x:Name="DisplayCodeTextbox"
                Margin="0,0,0,12"
                IsReadOnly="True" />
            <TextBlock Margin="0,0,0,4" Text="Info code" />
            <ui:TextBox
                x:Name="InfoCodeTextbox"
                Margin="0,0,0,12"
                IsReadOnly="True" />
            <TextBlock Margin="0,0,0,4" Text="Parent" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox
                    x:Name="ParentTextbox"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    IsReadOnly="True" />
                <ui:Button
                    x:Name="ParentButton"
                    Grid.Column="1"
                    Click="ParentButton_Click"
                    Content="Details" />
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
