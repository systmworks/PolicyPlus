<ui:FluentWindow
    x:Class="PolicyPlus.Views.OpenUserRegistryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Open User Hive"
    Width="420"
    Height="280"
    ExtendsContentIntoTitleBar="True"
    KeyDown="Window_KeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="0,40,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Open User Hive" />

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListView x:Name="SubfoldersListview" Grid.Row="0" Margin="0,0,0,10">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="220" DisplayMemberBinding="{Binding Folder}" Header="Folder Name" />
                        <GridViewColumn Width="120" DisplayMemberBinding="{Binding Access}" Header="Accessible" />
                    </GridView>
                </ListView.View>
            </ListView>

            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Right">
                <ui:Button
                    Appearance="Primary"
                    Click="OkButton_Click"
                    Content="OK"
                    IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
