<ui:FluentWindow
    x:Class="PolicyPlus.Views.EditPolMultiStringDataWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Edit String List"
    Width="420"
    Height="340"
    ExtendsContentIntoTitleBar="True"
    KeyDown="Window_KeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Edit String List" />

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="0,0,0,4" Text="Value name" />
            <ui:TextBox
                x:Name="TextName"
                Grid.Row="1"
                Margin="0,0,0,12"
                IsReadOnly="True" />
            <TextBlock Grid.Row="2" Margin="0,0,0,4" VerticalAlignment="Top" Text="Entries" />
            <ui:TextBox
                x:Name="TextData"
                Grid.Row="2"
                Margin="0,20,0,0"
                AcceptsReturn="True"
                TextWrapping="NoWrap"
                VerticalContentAlignment="Top"
                VerticalScrollBarVisibility="Auto" />
            <StackPanel
                Grid.Row="3"
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    Appearance="Primary"
                    Click="ButtonOK_Click"
                    Content="OK"
                    IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
