<ui:FluentWindow
    x:Class="PolicyPlus.Views.DetailProductWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Product Details"
    Width="440"
    Height="480"
    ExtendsContentIntoTitleBar="True"
    KeyDown="Window_KeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="0,40,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Product Details" />

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="0,0,0,4" Text="Name" />
            <ui:TextBox
                x:Name="NameTextbox"
                Grid.Row="1"
                Margin="0,0,0,10"
                IsReadOnly="True" />

            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Margin="0,0,0,4" Text="Unique ID" />
                <ui:TextBox x:Name="IdTextbox" Grid.Row="1" IsReadOnly="True" />
            </Grid>

            <Grid Grid.Row="3" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Margin="0,0,0,4" Text="Defined in" />
                <ui:TextBox x:Name="DefinedTextbox" Grid.Row="1" IsReadOnly="True" />
            </Grid>

            <Grid Grid.Row="4" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Margin="0,0,0,4" Text="Display code" />
                <ui:TextBox x:Name="DisplayCodeTextbox" Grid.Row="1" IsReadOnly="True" />
            </Grid>

            <Grid Grid.Row="5" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,0,4"
                    Text="Kind" />
                <ui:TextBox
                    x:Name="KindTextbox"
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    IsReadOnly="True" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,0,4"
                    Text="Version number" />
                <ui:TextBox
                    x:Name="VersionTextbox"
                    Grid.Row="1"
                    Grid.Column="1"
                    IsReadOnly="True" />
            </Grid>

            <Grid Grid.Row="6" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,0,4"
                    Text="Parent" />
                <ui:TextBox
                    x:Name="ParentTextbox"
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    IsReadOnly="True" />
                <ui:Button
                    x:Name="ParentButton"
                    Grid.Row="1"
                    Grid.Column="1"
                    Click="ParentButton_Click"
                    Content="Details" />
            </Grid>

            <TextBlock Grid.Row="7" Margin="0,0,0,4" VerticalAlignment="Top" Text="Subproducts" />
            <ListView
                x:Name="ChildrenListview"
                Grid.Row="7"
                Margin="0,20,0,0"
                MouseDoubleClick="ChildrenListview_MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="60" DisplayMemberBinding="{Binding Version}" Header="Version" />
                        <GridViewColumn Width="260" DisplayMemberBinding="{Binding Name}" Header="Name" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</ui:FluentWindow>
