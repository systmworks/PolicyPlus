<ui:FluentWindow
    x:Class="PolicyPlus.Views.InspectSpolFragmentWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Semantic Policy Fragment"
    Width="420"
    Height="380"
    MinWidth="380"
    MinHeight="300"
    ExtendsContentIntoTitleBar="True"
    KeyDown="Window_KeyDown"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="0,40,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Semantic Policy Fragment" />

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="0,0,0,4" Text="Policy" />
            <ui:TextBox
                x:Name="TextPolicyName"
                Grid.Row="1"
                Margin="0,0,0,12"
                IsReadOnly="True" />

            <ui:TextBox
                x:Name="TextSpol"
                Grid.Row="2"
                AcceptsReturn="True"
                FontFamily="Consolas"
                HorizontalScrollBarVisibility="Auto"
                IsReadOnly="True"
                KeyDown="TextSpol_KeyDown"
                TextWrapping="NoWrap"
                VerticalScrollBarVisibility="Auto" />

            <CheckBox
                x:Name="CheckHeader"
                Grid.Row="3"
                Margin="0,8,0,0"
                Checked="CheckHeader_CheckedChanged"
                Content="Include SPOL header"
                Unchecked="CheckHeader_CheckedChanged" />

            <StackPanel
                Grid.Row="4"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    Click="ButtonCopy_Click"
                    Content="Copy" />
                <ui:Button
                    Appearance="Primary"
                    Click="ButtonClose_Click"
                    Content="Close"
                    IsCancel="True"
                    IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
