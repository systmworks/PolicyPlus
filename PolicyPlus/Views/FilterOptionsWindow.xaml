<ui:FluentWindow
    x:Class="PolicyPlus.Views.FilterOptionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Filter Options"
    Width="420"
    Height="480"
    ExtendsContentIntoTitleBar="True"
    KeyDown="Window_KeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Filter Options" />

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Margin="0,0,0,4" Text="Policy type" />
                    <ComboBox x:Name="PolicyTypeCombobox" SelectedIndex="0">
                        <ComboBoxItem Content="Any" />
                        <ComboBoxItem Content="Policy" />
                        <ComboBoxItem Content="Preference" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Margin="0,0,0,4" Text="Current state" />
                    <ComboBox x:Name="PolicyStateCombobox" SelectedIndex="0">
                        <ComboBoxItem Content="Any" />
                        <ComboBoxItem Content="Not Configured" />
                        <ComboBoxItem Content="Configured" />
                        <ComboBoxItem Content="Enabled" />
                        <ComboBoxItem Content="Disabled" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Margin="0,0,0,4" Text="Commented" />
                    <ComboBox x:Name="CommentedCombobox" SelectedIndex="0">
                        <ComboBoxItem Content="Any" />
                        <ComboBoxItem Content="Yes" />
                        <ComboBoxItem Content="No" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <CheckBox
                x:Name="SupportedCheckbox"
                Grid.Row="1"
                Margin="0,0,0,8"
                Checked="SupportedCheckbox_CheckedChanged"
                Content="Supported on"
                Unchecked="SupportedCheckbox_CheckedChanged" />

            <GroupBox
                x:Name="RequirementsBox"
                Grid.Row="2"
                Margin="0,0,0,12"
                IsEnabled="False">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <CheckBox
                        x:Name="AlwaysMatchAnyCheckbox"
                        Grid.Row="0"
                        Margin="0,0,0,4"
                        Content="Match a policy if at least one selected product is supported"
                        IsChecked="True" />
                    <CheckBox
                        x:Name="MatchBlankSupportCheckbox"
                        Grid.Row="1"
                        Margin="0,0,0,8"
                        Content="Match policies with missing or blank support definitions"
                        IsChecked="True" />
                    <TreeView x:Name="AllowedProductsTreeview" Grid.Row="2">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type TreeViewItem}}" TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Grid>
            </GroupBox>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Button
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    Click="ResetButton_Click"
                    Content="Reset" />
                <ui:Button
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Appearance="Primary"
                    Click="OkButton_Click"
                    Content="OK"
                    IsDefault="True" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
