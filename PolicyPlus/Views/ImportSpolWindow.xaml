<ui:FluentWindow
    x:Class="PolicyPlus.Views.ImportSpolWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Import Semantic Policy"
    Width="440"
    Height="360"
    MinWidth="400"
    MinHeight="300"
    ExtendsContentIntoTitleBar="True"
    KeyDown="Window_KeyDown"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="0,40,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Import Semantic Policy" />

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Semantic Policy (SPOL) text" />
                <ui:Button
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    Click="ButtonReset_Click"
                    Content="Reset" />
                <ui:Button Grid.Column="2" Click="ButtonOpenFile_Click" Content="Open File" />
            </Grid>

            <ui:TextBox
                x:Name="TextSpol"
                Grid.Row="1"
                AcceptsReturn="True"
                FontFamily="Consolas"
                HorizontalScrollBarVisibility="Auto"
                KeyDown="TextSpol_KeyDown"
                TextWrapping="NoWrap"
                VerticalScrollBarVisibility="Auto" />

            <StackPanel
                Grid.Row="2"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    Click="ButtonVerify_Click"
                    Content="Verify" />
                <ui:Button
                    Appearance="Primary"
                    Click="ButtonApply_Click"
                    Content="Apply"
                    IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
