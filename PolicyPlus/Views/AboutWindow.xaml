<ui:FluentWindow
    x:Class="PolicyPlus.Views.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="About Policy Plus"
    Width="380"
    SizeToContent="Height"
    ExtendsContentIntoTitleBar="True"
    KeyDown="Window_KeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="About Policy Plus" />

        <StackPanel Grid.Row="1" Margin="20">
            <TextBlock
                Margin="0,0,0,4"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Policy Plus" />
            <TextBlock
                x:Name="VersionText"
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Version" />
            <TextBlock
                Margin="0,0,0,4"
                Text="Maintained by Darren Milne, originally created by Ben Nordick."
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,0,0,16"
                Text="Available on GitHub: systmworks/PolicyPlus"
                TextWrapping="Wrap" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button
                    Appearance="Primary"
                    Click="CloseButton_Click"
                    Content="Close"
                    IsCancel="True"
                    IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
