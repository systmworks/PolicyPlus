<ui:FluentWindow
    x:Class="PolicyPlus.Views.OpenPolWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Open Policy Resources"
    Width="560"
    SizeToContent="Height"
    ExtendsContentIntoTitleBar="True"
    KeyDown="Window_KeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Open Policy Resources" />

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <GroupBox
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,8,0"
                Header="Computer">
                <StackPanel Margin="8">
                    <RadioButton
                        x:Name="CompLocalOption"
                        Margin="0,0,0,8"
                        Checked="CompOptionsCheckedChanged"
                        Content="Local GPO" />
                    <RadioButton
                        x:Name="CompRegistryOption"
                        Margin="0,0,0,4"
                        Checked="CompOptionsCheckedChanged"
                        Content="Local Registry" />
                    <ui:TextBox
                        x:Name="CompRegTextbox"
                        Margin="0,0,0,8"
                        Text="HKLM" />
                    <RadioButton
                        x:Name="CompFileOption"
                        Margin="0,0,0,4"
                        Checked="CompOptionsCheckedChanged"
                        Content="POL file" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            x:Name="CompPolFilenameTextbox"
                            Grid.Column="0"
                            Margin="0,0,4,0" />
                        <ui:Button
                            x:Name="CompFileBrowseButton"
                            Grid.Column="1"
                            Click="CompFileBrowseButton_Click"
                            Content="..." />
                    </Grid>
                    <RadioButton x:Name="CompNullOption" Content="Scratch space (null)" />
                </StackPanel>
            </GroupBox>

            <GroupBox
                Grid.Row="0"
                Grid.Column="1"
                Margin="8,0,0,0"
                Header="User">
                <StackPanel Margin="8">
                    <RadioButton
                        x:Name="UserLocalOption"
                        Margin="0,0,0,8"
                        Checked="UserOptionsCheckedChanged"
                        Content="Local GPO" />
                    <RadioButton
                        x:Name="UserRegistryOption"
                        Margin="0,0,0,4"
                        Checked="UserOptionsCheckedChanged"
                        Content="Local Registry" />
                    <ui:TextBox
                        x:Name="UserRegTextbox"
                        Margin="0,0,0,8"
                        Text="HKCU" />
                    <RadioButton
                        x:Name="UserFileOption"
                        Margin="0,0,0,4"
                        Checked="UserOptionsCheckedChanged"
                        Content="POL file" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            x:Name="UserPolFilenameTextbox"
                            Grid.Column="0"
                            Margin="0,0,4,0" />
                        <ui:Button
                            x:Name="UserFileBrowseButton"
                            Grid.Column="1"
                            Click="UserFileBrowseButton_Click"
                            Content="..." />
                    </Grid>
                    <RadioButton
                        x:Name="UserPerUserGpoOption"
                        Margin="0,0,0,4"
                        Checked="UserOptionsCheckedChanged"
                        Content="User GPO" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            x:Name="UserGpoSidTextbox"
                            Grid.Column="0"
                            Margin="0,0,4,0" />
                        <ui:Button
                            x:Name="UserBrowseGpoButton"
                            Grid.Column="1"
                            Click="UserBrowseGpoButton_Click"
                            Content="..." />
                    </Grid>
                    <RadioButton
                        x:Name="UserPerUserRegOption"
                        Margin="0,0,0,4"
                        Checked="UserOptionsCheckedChanged"
                        Content="User hive" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            x:Name="UserHivePathTextbox"
                            Grid.Column="0"
                            Margin="0,0,4,0" />
                        <ui:Button
                            x:Name="UserBrowseHiveButton"
                            Grid.Column="1"
                            Click="UserBrowseRegistryButton_Click"
                            Content="..." />
                    </Grid>
                    <RadioButton x:Name="UserNullOption" Content="Scratch space (null)" />
                </StackPanel>
            </GroupBox>

            <StackPanel
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    Appearance="Primary"
                    Click="OkButton_Click"
                    Content="OK"
                    IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
