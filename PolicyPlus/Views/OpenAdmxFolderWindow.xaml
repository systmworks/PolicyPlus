<ui:FluentWindow
    x:Class="PolicyPlus.Views.OpenAdmxFolderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Open ADMX Folder"
    Width="480"
    SizeToContent="Height"
    ExtendsContentIntoTitleBar="True"
    KeyDown="Window_KeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Open ADMX Folder" />

        <StackPanel
            Grid.Row="1"
            Margin="16"
            VerticalAlignment="Top">
            <TextBlock Margin="0,0,0,8" Text="Where would you like to load ADMX files from?" />
            <RadioButton
                x:Name="OptLocalFolder"
                Margin="0,0,0,8"
                Checked="Options_CheckedChanged"
                Content="This system's PolicyDefinitions folder" />
            <RadioButton
                x:Name="OptSysvol"
                Margin="0,0,0,8"
                Checked="Options_CheckedChanged"
                Content="The domain's SYSVOL" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <RadioButton
                    x:Name="OptCustomFolder"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Checked="Options_CheckedChanged"
                    Content="This folder:" />
                <ui:TextBox
                    x:Name="TextFolder"
                    Grid.Column="1"
                    Margin="0,0,8,0" />
                <ui:Button Grid.Column="2" Click="ButtonBrowse_Click" Content="Browse" />
            </Grid>
            <CheckBox
                x:Name="ClearWorkspaceCheckbox"
                Margin="0,0,0,0"
                Content="Clear the workspace before adding this folder"
                IsChecked="True" />
            <StackPanel
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    Appearance="Primary"
                    Click="ButtonOK_Click"
                    Content="OK"
                    IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
