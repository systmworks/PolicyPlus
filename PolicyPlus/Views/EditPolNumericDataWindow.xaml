<ui:FluentWindow
    x:Class="PolicyPlus.Views.EditPolNumericDataWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Edit Number"
    Width="360"
    SizeToContent="Height"
    ExtendsContentIntoTitleBar="True"
    KeyDown="Window_KeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Edit Number" />

        <StackPanel Grid.Row="1" Margin="16">
            <TextBlock Margin="0,0,0,4" Text="Value name" />
            <ui:TextBox
                x:Name="NameTextBox"
                Margin="0,0,0,12"
                IsReadOnly="True" />

            <TextBlock Margin="0,0,0,4" Text="Number" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox
                    x:Name="ValueTextBox"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    KeyDown="ValueTextBox_KeyDown"
                    LostFocus="ValueTextBox_LostFocus" />
                <CheckBox
                    x:Name="HexCheckBox"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Checked="HexCheckBox_CheckedChanged"
                    Content="Hexadecimal"
                    Unchecked="HexCheckBox_CheckedChanged" />
            </Grid>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button
                    Appearance="Primary"
                    Click="OkButton_Click"
                    Content="OK"
                    IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
