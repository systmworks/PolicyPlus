<ui:FluentWindow
    x:Class="PolicyPlus.Views.EditPolWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Edit Raw POL"
    Width="640"
    Height="440"
    MinWidth="520"
    MinHeight="360"
    ExtendsContentIntoTitleBar="True"
    KeyDown="Window_KeyDown"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Edit Raw POL" />

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10" Orientation="Horizontal">
                <ui:Button
                    x:Name="ButtonAddKey"
                    Margin="0,0,8,0"
                    Click="ButtonAddKey_Click"
                    Content="Add Key" />
                <ui:Button
                    x:Name="ButtonAddValue"
                    Margin="0,0,8,0"
                    Click="ButtonAddValue_Click"
                    Content="Add Value" />
                <ui:Button
                    x:Name="ButtonDeleteValue"
                    Margin="0,0,8,0"
                    Click="ButtonDeleteValue_Click"
                    Content="Delete Value(s)" />
                <ui:Button
                    x:Name="ButtonForget"
                    Margin="0,0,8,0"
                    Click="ButtonForget_Click"
                    Content="Forget" />
                <ui:Button
                    x:Name="ButtonEdit"
                    Click="ButtonEdit_Click"
                    Content="Edit" />
            </StackPanel>

            <ui:ListView
                x:Name="LsvPol"
                Grid.Row="1"
                Margin="0,0,0,10"
                SelectionChanged="LsvPol_SelectionChanged">
                <ui:ListView.View>
                    <GridView>
                        <GridViewColumn Width="360" Header="Name">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="{Binding Indent}" Orientation="Horizontal">
                                        <Image
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,4,0"
                                            Source="{Binding Icon}" />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="180" DisplayMemberBinding="{Binding Value}" Header="Value" />
                    </GridView>
                </ui:ListView.View>
            </ui:ListView>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Click="ButtonImport_Click"
                        Content="Import REG" />
                    <ui:Button Click="ButtonExport_Click" Content="Export REG" />
                </StackPanel>
                <ui:Button
                    Grid.Column="1"
                    Appearance="Primary"
                    Click="ButtonSave_Click"
                    Content="Done"
                    IsDefault="True" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
