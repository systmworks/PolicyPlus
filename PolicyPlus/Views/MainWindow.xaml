<ui:FluentWindow
    x:Class="PolicyPlus.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PolicyPlus.ViewModels"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Policy Plus"
    Width="900"
    Height="620"
    MinWidth="600"
    MinHeight="400"
    Closing="Window_Closing"
    Closed="Window_Closed"
    Loaded="Window_Loaded"
    PreviewKeyDown="Window_PreviewKeyDown"
    ExtendsContentIntoTitleBar="True"
    ShowInTaskbar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <HierarchicalDataTemplate DataType="{x:Type local:CategoryNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Image Width="16" Height="16" Margin="0,0,4,0">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Source" Value="{Binding Icon}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Source" Value="{Binding SelectedIcon}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <TextBlock Text="{Binding DisplayName}" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate x:Key="PolicyNameCellTemplate">
            <StackPanel Orientation="Horizontal">
                <Image
                    Width="16"
                    Height="16"
                    Margin="0,0,4,0"
                    Source="{Binding Icon}" />
                <TextBlock Text="{Binding Name}" />
            </StackPanel>
        </DataTemplate>

        <!--
            BasedOn the app-wide corrected TreeViewItem style (see WpfInterop.AddOpaqueListSurfaceStyles)
            rather than a bare TargetType="TreeViewItem" style - a local ItemContainerStyle like this
            one always wins over the app-wide implicit style, so without BasedOn it would silently
            drop the Foreground fix and the tree would go back to invisible/low-contrast text.
        -->
        <Style
            x:Key="CategoryTreeItemStyle"
            BasedOn="{StaticResource {x:Type TreeViewItem}}"
            TargetType="TreeViewItem">
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        </Style>

        <!--
            WPF-UI's stock top-level menu header template is built for touch-friendly menus: its
            outer Border carries Margin="4" and the inner Grid Margin="10", so each header wants
            ~47px of height for ~19px of text. In a desktop menu bar that reads as a fat, mostly
            empty strip above the content. This is a copy of that template with only the vertical
            margins reduced (horizontal spacing and every trigger/animation kept as-is), bringing a
            header down to ~29px so the menu row is sized by the 32px search box next to it.

            It has to be a whole template copy rather than a Setter: the margins are baked into
            WPF-UI's ControlTemplate, and their style resolves the template via StaticResource at
            its own definition site, so re-keying TopLevelHeaderTemplateKey here would never be
            seen. Applied through Menu.ItemContainerStyle (below), which reaches only the top-level
            headers - items inside the dropdowns keep WPF-UI's default look, where the roomier
            padding is correct.
        -->
        <ControlTemplate x:Key="CompactTopLevelHeaderTemplate" TargetType="{x:Type MenuItem}">
            <Border
                x:Name="Border"
                Margin="1,2,1,2"
                Background="Transparent"
                CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="10,3,10,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter
                            x:Name="Icon"
                            Grid.Column="0"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Icon}" />
                        <ContentPresenter
                            x:Name="Header"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            ContentSource="Header"
                            RecognizesAccessKey="True"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>

                    <Popup
                        x:Name="Popup"
                        Grid.Row="1"
                        Grid.Column="0"
                        AllowsTransparency="True"
                        Focusable="False"
                        HorizontalOffset="-12"
                        IsOpen="{TemplateBinding IsSubmenuOpen}"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=Border}"
                        PopupAnimation="None"
                        VerticalOffset="1">
                        <Grid>
                            <Border
                                x:Name="SubmenuBorder"
                                Margin="12,0,12,18"
                                Padding="0,3,0,3"
                                Background="{DynamicResource FlyoutBackground}"
                                BorderBrush="{DynamicResource FlyoutBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <TranslateTransform />
                                </Border.RenderTransform>
                                <ui:PassiveScrollViewer CanContentScroll="True" Style="{StaticResource UiMenuItemScrollViewer}">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </ui:PassiveScrollViewer>
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="20"
                                        Direction="270"
                                        Opacity="0.135"
                                        ShadowDepth="10"
                                        Color="#202020" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsPressed" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}" />
                </MultiTrigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsPressed" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuBarItemBackgroundPressed}" />
                    <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource MenuBarItemTextForegroundPressed}" />
                    <Setter TargetName="Header" Property="TextElement.Foreground" Value="{DynamicResource MenuBarItemTextForegroundPressed}" />
                </MultiTrigger>
                <Trigger Property="Icon" Value="{x:Null}">
                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground">
                        <Setter.Value>
                            <SolidColorBrush Color="{DynamicResource TextFillColorDisabled}" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetName="SubmenuBorder"
                                    Storyboard.TargetProperty="(Border.RenderTransform).(TranslateTransform.Y)"
                                    From="-90"
                                    To="0"
                                    Duration="00:00:00.167">
                                    <DoubleAnimation.EasingFunction>
                                        <CircleEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!--
            Standalone (not BasedOn WPF-UI's) so there's no trigger-vs-trigger precedence question
            over which Template wins for the TopLevelHeader role. Foreground is set explicitly
            because OverridesDefaultStyle drops WPF-UI's own value and the template binds the
            header text's Foreground straight from it - without this the menu text renders
            invisible, the same class of bug as the ListView/TreeView text fixes.
        -->
        <Style x:Key="CompactTopLevelMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template" Value="{StaticResource CompactTopLevelHeaderTemplate}" />
                    <Setter Property="Grid.IsSharedSizeScope" Value="True" />
                </Trigger>
                <Trigger Property="Role" Value="TopLevelItem">
                    <Setter Property="Template" Value="{StaticResource {x:Static MenuItem.TopLevelItemTemplateKey}}" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />

        <DockPanel Grid.Row="1" Margin="8,0,8,0" LastChildFill="False">
            <Menu
                DockPanel.Dock="Left"
                VerticalAlignment="Center"
                Background="Transparent"
                ItemContainerStyle="{StaticResource CompactTopLevelMenuItemStyle}">
                <MenuItem Header="_File">
                    <MenuItem x:Name="OpenAdmxFolderMenuItem" Click="OpenAdmxFolderMenuItem_Click" Header="Open ADMX Folder" />
                    <MenuItem x:Name="OpenAdmxFileMenuItem" Click="OpenAdmxFileMenuItem_Click" Header="Open ADMX File" />
                    <MenuItem x:Name="SetAdmlLanguageMenuItem" Click="SetAdmlLanguageMenuItem_Click" Header="Set ADML Language" />
                    <MenuItem x:Name="CloseAdmxWorkspaceMenuItem" Click="CloseAdmxWorkspaceMenuItem_Click" Header="Close ADMX Workspace" />
                    <Separator />
                    <MenuItem x:Name="OpenPolicyResourcesMenuItem" Click="OpenPolicyResourcesMenuItem_Click" Header="Open Policy Resources" InputGestureText="Ctrl+O" />
                    <MenuItem x:Name="OpenRegFileMenuItem" Click="OpenRegFileMenuItem_Click" Header="Open REG File" />
                    <MenuItem x:Name="SavePoliciesMenuItem" Click="SavePoliciesMenuItem_Click" Header="Save Policies" InputGestureText="Ctrl+S" />
                    <MenuItem x:Name="ResetAllToDefaultMenuItem" Click="ResetAllToDefaultMenuItem_Click" Header="Reset All to Default" />
                    <MenuItem x:Name="EditRawPolMenuItem" Click="EditRawPolMenuItem_Click" Header="Edit Raw POL" />
                    <Separator />
                    <MenuItem x:Name="ExitMenuItem" Click="ExitMenuItem_Click" Header="Exit" />
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem x:Name="EmptyCategoriesMenuItem" Click="EmptyCategoriesMenuItem_Click" Header="Empty Categories" IsCheckable="True" />
                    <MenuItem x:Name="OnlyFilteredObjectsMenuItem" Click="OnlyFilteredObjectsMenuItem_Click" Header="Only Filtered Policies" IsCheckable="True" />
                    <Separator />
                    <MenuItem x:Name="FilterOptionsMenuItem" Click="FilterOptionsMenuItem_Click" Header="Filter Options" />
                    <MenuItem
                        x:Name="DeduplicatePoliciesMenuItem"
                        Click="DeduplicatePoliciesMenuItem_Click"
                        Header="Deduplicate Policies"
                        Visibility="Collapsed" />
                    <Separator />
                    <MenuItem x:Name="LoadedAdmxFilesMenuItem" Click="LoadedAdmxFilesMenuItem_Click" Header="Loaded ADMX Files" />
                    <MenuItem x:Name="AllProductsMenuItem" Click="AllProductsMenuItem_Click" Header="All Products" />
                    <MenuItem x:Name="AllSupportDefinitionsMenuItem" Click="AllSupportDefinitionsMenuItem_Click" Header="All Support Definitions" />
                </MenuItem>
                <MenuItem Header="F_ind">
                    <MenuItem x:Name="ByIdMenuItem" Click="ByIdMenuItem_Click" Header="By ID" InputGestureText="Ctrl+G" />
                    <MenuItem x:Name="ByTextMenuItem" Click="ByTextMenuItem_Click" Header="By Text" InputGestureText="Ctrl+F" />
                    <MenuItem x:Name="ByRegistryMenuItem" Click="ByRegistryMenuItem_Click" Header="By Registry" InputGestureText="Ctrl+R" />
                    <Separator />
                    <MenuItem x:Name="SearchResultsMenuItem" Click="SearchResultsMenuItem_Click" Header="Search Results" InputGestureText="Shift+F3" />
                    <MenuItem x:Name="FindNextMenuItem" Click="FindNextMenuItem_Click" Header="Find Next" InputGestureText="F3" />
                </MenuItem>
                <MenuItem Header="_Share">
                    <MenuItem x:Name="ImportSemanticPolicyMenuItem" Click="ImportSemanticPolicyMenuItem_Click" Header="Import Semantic Policy" />
                    <MenuItem x:Name="ImportPolMenuItem" Click="ImportPolMenuItem_Click" Header="Import POL" />
                    <MenuItem x:Name="ImportRegMenuItem" Click="ImportRegMenuItem_Click" Header="Import REG" />
                    <Separator />
                    <MenuItem x:Name="ExportPolMenuItem" Click="ExportPolMenuItem_Click" Header="Export POL" />
                    <MenuItem x:Name="ExportRegMenuItem" Click="ExportRegMenuItem_Click" Header="Export REG" />
                </MenuItem>
                <MenuItem Header="_Options">
                    <MenuItem Header="Color Mode">
                        <MenuItem x:Name="SolarizedLightMenuItem" Click="SolarizedLightMenuItem_Click" Header="(Light) Solarized Light" IsCheckable="True" />
                        <MenuItem x:Name="GruvboxLightMenuItem" Click="GruvboxLightMenuItem_Click" Header="(Light) Gruvbox Light" IsCheckable="True" />
                        <MenuItem x:Name="CatppuccinLatteMenuItem" Click="CatppuccinLatteMenuItem_Click" Header="(Light) Catppuccin Latte" IsCheckable="True" />
                        <MenuItem x:Name="NordMenuItem" Click="NordMenuItem_Click" Header="(Dark) Nord" IsCheckable="True" />
                        <MenuItem x:Name="DraculaMenuItem" Click="DraculaMenuItem_Click" Header="(Dark) Dracula" IsCheckable="True" />
                        <MenuItem x:Name="RosePineMenuItem" Click="RosePineMenuItem_Click" Header="(Dark) Rosé Pine" IsCheckable="True" />
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem x:Name="AboutMenuItem" Click="AboutMenuItem_Click" Header="About" />
                    <MenuItem x:Name="AcquireAdmxFilesMenuItem" Click="AcquireAdmxFilesMenuItem_Click" Header="Acquire ADMX Files" />
                </MenuItem>
            </Menu>

            <StackPanel
                DockPanel.Dock="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <ui:Button
                    x:Name="ClearSearchButton"
                    Height="32"
                    Margin="4,0,0,0"
                    Click="ClearSearchButton_Click"
                    Content="✕"
                    ToolTip="Clear search (Esc)" />
                <ui:Button
                    x:Name="SearchButton"
                    Height="32"
                    Margin="4,0,0,0"
                    Click="SearchButton_Click"
                    Content="🔍"
                    ToolTip="Search (Enter)" />
                <ui:TextBox
                    x:Name="SearchTextbox"
                    Width="390"
                    Height="32"
                    Margin="8,0,0,0"
                    KeyDown="SearchTextbox_KeyDown"
                    PlaceholderText="Search policies..." />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="DescriptionColumn" Width="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ComboBox
                    x:Name="ComboAppliesTo"
                    Grid.Row="0"
                    Margin="0,0,0,4"
                    SelectedIndex="0"
                    SelectionChanged="ComboAppliesTo_SelectionChanged">
                    <ComboBoxItem Content="User or Computer" />
                    <ComboBoxItem Content="User" />
                    <ComboBoxItem Content="Computer" />
                </ComboBox>
                <TreeView
                    x:Name="CategoriesTree"
                    Grid.Row="1"
                    ItemContainerStyle="{StaticResource CategoryTreeItemStyle}"
                    PreviewMouseRightButtonDown="CategoriesTree_PreviewMouseRightButtonDown"
                    SelectedItemChanged="CategoriesTree_SelectedItemChanged">
                    <!--
                        One shared ContextMenu, re-parented at open time to whichever of
                        CategoriesTree/PoliciesList was right-clicked (see ShowPolicyObjectContext in
                        code-behind) - a WPF ContextMenu, like any FrameworkElement, can only be the
                        logical child of one control at a time, unlike a WinForms ContextMenuStrip
                        which could be assigned to several controls simultaneously. Declared here (not
                        in FluentWindow.Resources) because named elements inside a keyed resource
                        entry get their own separate NameScope and never get x:Name fields wired up.
                        Tag "P"/"C" marks policy-only/category-only items for ShowPolicyObjectContext's
                        visibility filter, matching the original Designer-time item tagging.
                    -->
                    <TreeView.ContextMenu>
                        <ContextMenu x:Name="PolicyObjectContext">
                            <MenuItem
                                x:Name="CmeCatOpen"
                                Click="CmeCatOpen_Click"
                                FontWeight="Bold"
                                Header="Open"
                                Tag="C" />
                            <MenuItem
                                x:Name="CmePolEdit"
                                Click="CmePolEdit_Click"
                                FontWeight="Bold"
                                Header="Edit"
                                Tag="P" />
                            <MenuItem
                                x:Name="CmeFavoriteToggle"
                                Click="CmeFavoriteToggle_Click"
                                Header="Add to Favorites"
                                Tag="P" />
                            <MenuItem x:Name="CmeAllDetails" Click="CmeAllDetails_Click" Header="Details" />
                            <MenuItem
                                x:Name="CmePolInspectElements"
                                Click="CmePolInspectElements_Click"
                                Header="Element Inspector"
                                Tag="P" />
                            <MenuItem
                                x:Name="CmePolSpolFragment"
                                Click="CmePolSpolFragment_Click"
                                Header="Semantic Policy Fragment"
                                Tag="P" />
                            <Separator x:Name="CmeCopySeparator" />
                            <MenuItem
                                x:Name="CmeCopyId"
                                Click="CmeCopyId_Click"
                                Header="Copy ID"
                                Tag="P" />
                            <MenuItem
                                x:Name="CmeCopyName"
                                Click="CmeCopyName_Click"
                                Header="Copy Name"
                                Tag="P" />
                            <MenuItem
                                x:Name="CmeCopyRegPath"
                                Click="CmeCopyRegPath_Click"
                                Header="Copy Registry Path"
                                Tag="P" />
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
            </Grid>

            <GridSplitter
                Grid.Column="1"
                Width="4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent" />

            <ScrollViewer
                Grid.Column="2"
                Margin="4,0,0,0"
                VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SettingInfoPanel" Margin="4">
                    <TextBlock
                        x:Name="PolicyTitleLabel"
                        Margin="0,0,0,8"
                        FontWeight="Bold"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="PolicySupportedLabel"
                        Margin="0,0,0,8"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <StackPanel
                        x:Name="PolicyIsPrefPanel"
                        Margin="0,0,0,8"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <Image
                            x:Name="PolicyIsPrefIcon"
                            Width="16"
                            Height="16"
                            Margin="0,0,6,0"
                            VerticalAlignment="Top" />
                        <TextBlock
                            x:Name="PolicyIsPrefLabel"
                            Text="Because it is not stored in a Policies section of the Registry, this policy is a preference and will not be automatically undone if the setting is removed."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock x:Name="PolicyDescLabel" Text="Select an item to see its description." TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <GridSplitter
                Grid.Column="3"
                Width="4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent" />

            <ui:ListView
                x:Name="PoliciesList"
                Grid.Column="4"
                Margin="4,0,0,0"
                KeyDown="PoliciesList_KeyDown"
                MouseDoubleClick="PoliciesList_MouseDoubleClick"
                PreviewMouseRightButtonDown="PoliciesList_PreviewMouseRightButtonDown"
                SelectionChanged="PoliciesList_SelectionChanged"
                SelectionMode="Single"
                SizeChanged="PoliciesList_SizeChanged">
                <ui:ListView.View>
                    <GridView>
                        <GridViewColumn x:Name="NameColumn" Width="300" CellTemplate="{StaticResource PolicyNameCellTemplate}">
                            <GridViewColumnHeader x:Name="NameColumnHeader" Click="ColumnHeader_Click" Content="Name" Tag="0" />
                        </GridViewColumn>
                        <GridViewColumn x:Name="StateColumn" Width="107" DisplayMemberBinding="{Binding State}">
                            <GridViewColumnHeader x:Name="StateColumnHeader" Click="ColumnHeader_Click" Content="State" Tag="1" />
                        </GridViewColumn>
                        <GridViewColumn x:Name="CommentColumn" Width="90" DisplayMemberBinding="{Binding Comment}">
                            <GridViewColumnHeader x:Name="CommentColumnHeader" Click="ColumnHeader_Click" Content="Comment" Tag="2" />
                        </GridViewColumn>
                        <GridViewColumn x:Name="IdColumn" Width="180" DisplayMemberBinding="{Binding Id}">
                            <GridViewColumnHeader x:Name="IdColumnHeader" Click="ColumnHeader_Click" Content="ID" Tag="3" />
                        </GridViewColumn>
                    </GridView>
                </ui:ListView.View>
            </ui:ListView>
        </Grid>

        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="Computer source:" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="ComputerSourceLabel" Text="Computer info" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="User source:" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="UserSourceLabel" Text="User info" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</ui:FluentWindow>
