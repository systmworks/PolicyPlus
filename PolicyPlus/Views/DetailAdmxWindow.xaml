<ui:FluentWindow
    x:Class="PolicyPlus.Views.DetailAdmxWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="ADMX Details"
    Width="520"
    Height="620"
    MinWidth="420"
    MinHeight="420"
    ExtendsContentIntoTitleBar="True"
    KeyDown="Window_KeyDown"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="0,40,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="ADMX Details" />

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="0,0,0,4" Text="Path" />
            <ui:TextBox
                x:Name="TextPath"
                Grid.Row="1"
                Margin="0,0,0,10"
                IsReadOnly="True" />
            <TextBlock Grid.Row="2" Margin="0,0,0,4" Text="Namespace" />
            <ui:TextBox
                x:Name="TextNamespace"
                Grid.Row="3"
                Margin="0,0,0,10"
                IsReadOnly="True" />
            <TextBlock Grid.Row="4" Margin="0,0,0,4" Text="Superseded ADM" />
            <ui:TextBox
                x:Name="TextSupersededAdm"
                Grid.Row="5"
                Margin="0,0,0,10"
                IsReadOnly="True" />

            <TextBlock Grid.Row="6" Margin="0,0,0,4" Text="Policies" />
            <ListView
                x:Name="LsvPolicies"
                Grid.Row="7"
                Margin="0,0,0,10"
                MouseDoubleClick="LsvPolicies_MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="90" DisplayMemberBinding="{Binding Id}" Header="Local ID" />
                        <GridViewColumn Width="280" DisplayMemberBinding="{Binding Name}" Header="Name" />
                    </GridView>
                </ListView.View>
            </ListView>

            <TextBlock Grid.Row="8" Margin="0,0,0,4" Text="Categories" />
            <ListView
                x:Name="LsvCategories"
                Grid.Row="9"
                Margin="0,0,0,10"
                MouseDoubleClick="LsvCategories_MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="90" DisplayMemberBinding="{Binding Id}" Header="Local ID" />
                        <GridViewColumn Width="280" DisplayMemberBinding="{Binding Name}" Header="Name" />
                    </GridView>
                </ListView.View>
            </ListView>

            <TextBlock Grid.Row="10" Margin="0,0,0,4" Text="Products" />
            <ListView
                x:Name="LsvProducts"
                Grid.Row="11"
                Margin="0,0,0,10"
                MouseDoubleClick="LsvProducts_MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="90" DisplayMemberBinding="{Binding Id}" Header="Local ID" />
                        <GridViewColumn Width="280" DisplayMemberBinding="{Binding Name}" Header="Name" />
                    </GridView>
                </ListView.View>
            </ListView>

            <TextBlock Grid.Row="12" Margin="0,0,0,4" Text="Support rules" />
            <ListView
                x:Name="LsvSupportDefinitions"
                Grid.Row="13"
                Margin="0,0,0,10"
                MouseDoubleClick="LsvSupportDefinitions_MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="90" DisplayMemberBinding="{Binding Id}" Header="Local ID" />
                        <GridViewColumn Width="280" DisplayMemberBinding="{Binding Name}" Header="Name" />
                    </GridView>
                </ListView.View>
            </ListView>

            <StackPanel
                Grid.Row="14"
                HorizontalAlignment="Right">
                <ui:Button Click="ButtonClose_Click" Content="Close" IsCancel="True" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
