<ui:FluentWindow
    x:Class="PolicyPlus.Views.Phase0ProofWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="WPF-UI Proof of Concept (Phase 0)"
    Width="480"
    Height="360"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="0,40,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="WPF-UI Proof of Concept" />

        <StackPanel
            Grid.Row="1"
            Margin="24"
            VerticalAlignment="Center">
            <ui:Card Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <ui:TextBlock
                        FontTypography="BodyStrong"
                        Text="This card has rounded corners, a shadow, and follows the live theme." />
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Phase 0 scaffolding - proves WinForms/WPF coexistence and live theming." />
                </StackPanel>
            </ui:Card>

            <TextBlock Margin="0,0,0,8" Text="Theme:" />
            <StackPanel Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    Click="LightButton_Click"
                    Content="Light" />
                <ui:Button
                    Margin="0,0,8,0"
                    Click="DarkButton_Click"
                    Content="Dark" />
                <ui:Button Click="SystemButton_Click" Content="System" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
