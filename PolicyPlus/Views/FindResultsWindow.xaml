<ui:FluentWindow
    x:Class="PolicyPlus.Views.FindResultsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Search Results"
    Width="820"
    Height="560"
    MinWidth="480"
    MinHeight="240"
    Closing="Window_Closing"
    ExtendsContentIntoTitleBar="True"
    KeyDown="Window_KeyDown"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Search Results" />

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar
                    x:Name="SearchProgress"
                    Grid.Column="0"
                    Height="18"
                    Margin="0,0,8,0" />
                <ui:Button
                    x:Name="StopButton"
                    Grid.Column="1"
                    Click="StopButton_Click"
                    Content="Stop" />
            </Grid>

            <TextBlock x:Name="ProgressLabel" Grid.Row="1" Margin="0,0,0,8" Text="Results: 0 (searching)" />

            <ui:ListView
                x:Name="ResultsListview"
                Grid.Row="2"
                Margin="0,0,0,8"
                MouseDoubleClick="GoClicked">
                <ui:ListView.Resources>
                    <!--
                        Explicit Foreground on the cell TextBlock itself, not DisplayMemberBinding's
                        plain auto-generated one - after three rounds of container/item-style fixes
                        for invisible ListView text, this is the one thing that can't be silently
                        out-prioritized by whatever WPF-UI's real item template does internally.
                    -->
                    <DataTemplate x:Key="TitleCellTemplate">
                        <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" />
                    </DataTemplate>
                    <DataTemplate x:Key="CategoryCellTemplate">
                        <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Category}" />
                    </DataTemplate>
                </ui:ListView.Resources>
                <ui:ListView.View>
                    <GridView>
                        <GridViewColumn Width="480" CellTemplate="{StaticResource TitleCellTemplate}" Header="Title" />
                        <GridViewColumn Width="280" CellTemplate="{StaticResource CategoryCellTemplate}" Header="Category" />
                    </GridView>
                </ui:ListView.View>
            </ui:ListView>

            <StackPanel
                Grid.Row="3"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    Click="CloseButton_Click"
                    Content="Close"
                    IsCancel="True" />
                <ui:Button
                    Appearance="Primary"
                    Click="GoClicked"
                    Content="Go"
                    IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
