<ui:FluentWindow
    x:Class="PolicyPlus.Views.LoadedSupportDefinitionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="All Support Definitions"
    Width="520"
    Height="380"
    ExtendsContentIntoTitleBar="True"
    KeyDown="Window_KeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="All Support Definitions" />

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Text="Substring (filter)" />
                <ui:TextBox
                    x:Name="TextFilter"
                    Grid.Column="1"
                    TextChanged="TextFilter_TextChanged" />
            </Grid>

            <ListView
                x:Name="LsvSupport"
                Grid.Row="1"
                Margin="0,0,0,8"
                KeyDown="LsvSupport_KeyDown"
                MouseDoubleClick="LsvSupport_MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="340" DisplayMemberBinding="{Binding Name}" Header="Name" />
                        <GridViewColumn Width="110" DisplayMemberBinding="{Binding DefinedIn}" Header="ADMX File" />
                    </GridView>
                </ListView.View>
            </ListView>

            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Right">
                <ui:Button Click="ButtonClose_Click" Content="Close" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
